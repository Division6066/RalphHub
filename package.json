		"mobile:sync": "npx cap sync android",
		"mobile:open": "npx cap open android",
		"mobile:build": "bash scripts/build-apk.sh",
		"mobile:keystore": "bash scripts/generate-keystore.sh",
		"e2e": "bash scripts/e2e-test.sh"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
