		"@tailwindcss/vite": "^4.2.1",
		"@tauri-apps/cli": "^2.10.1",
		"@types/qrcode": "^1.5.6",
		"autoprefixer": "^10.4.27",
		"postcss": "^8.5.8",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.2.1",
